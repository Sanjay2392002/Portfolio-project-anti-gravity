PORT=5000
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Public site origin. Production must use the exact HTTPS origin.
APP_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=

# Generate a unique 48+ character random value. Production requires it.
JWT_SECRET=

# First administrator bootstrap.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL is required in production. Local JSON storage is development-only.
DATABASE_URL=
# TLS is enabled for PostgreSQL by default. Disable it only for trusted local PostgreSQL.
DATABASE_SSL=

# Optional image CDN credentials. Leave empty when using local uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sanjay_portfolio_media
