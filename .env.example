# =============================================================================
# SANJAY PORTFOLIO ENVIRONMENT VARIABLES (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# -----------------------------------------------------------------------------
# Optional: Set this in Vercel if your backend API is hosted on Render or another external server.
# Leave empty if running fullstack on Vercel (using Vercel Serverless Functions).
# Example: https://sanjay-portfolio-backend.onrender.com
VITE_API_URL=

# -----------------------------------------------------------------------------
# 2. BACKEND / SERVER ENVIRONMENT VARIABLES (Render or Vercel Serverless)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Public site origin (allowed for CORS & cookie policy).
# Production should be your Vercel deployment URL (e.g. https://sanjay-portfolio.vercel.app).
APP_ORIGIN=https://your-portfolio.vercel.app
CORS_ORIGINS=https://your-portfolio.vercel.app

# Secure JWT secret key for signing admin authentication tokens (minimum 32 characters).
JWT_SECRET=your_minimum_32_characters_random_secure_jwt_secret

# Initial Administrator Credentials (used for bootstrapping / recovery).
ADMIN_USERNAME=Sanjay
ADMIN_EMAIL=sanjaymurugesan23@gmail.com
ADMIN_PASSWORD=your_strong_admin_password

# Database Configuration (PostgreSQL URL e.g. from Render PostgreSQL, Supabase, Neon).
# If left empty, the server will operate using the local JSON storage adapter.
DATABASE_URL=postgresql://username:password@host:5432/database_name
DATABASE_SSL=require
DATABASE_REJECT_UNAUTHORIZED=false

# Cloudinary Storage Configuration (Optional - for persistent cloud media uploads).
# Not required for authentication. If omitted, local/serverless fallback is used.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=sanjay_portfolio_media
